# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================
# Copia este archivo como '.env' y configura tus valores

# --------------------------------------------
# BASE DE DATOS
# --------------------------------------------
# URL de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:admin@localhost:5432/territorios_db?schema=public"

# --------------------------------------------
# AUTENTICACIÓN
# --------------------------------------------
# URL pública de la aplicación (necesaria para JWT)
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key para JWT (genera uno seguro en producción)
# Puedes generar uno con: openssl rand -base64 32
JWT_SECRET="tu-secreto-super-seguro-cambialo-en-produccion"

# Email y contraseña del super admin
# En el primer login se crea el tenant admin con estos datos
ADMIN_EMAIL="admin@territorios.com"
ADMIN_PASSWORD="123456"

# --------------------------------------------
# API PARA IA
# --------------------------------------------
# Clave para que la IA se autentique en el endpoint /api/agent
# La IA debe enviarla en el header: Authorization: Bearer <API_KEY>
AI_API_KEY="cambia-esta-clave-por-una-segura"

# --------------------------------------------
# EMAILS (EmailJS)
# --------------------------------------------
# Configuración de EmailJS para enviar emails transaccionales
# Crear cuenta en: https://www.emailjs.com/
# Public Key de EmailJS (Dashboard > Account > API Keys)
EMAILJS_PUBLIC_KEY="tu_public_key"
# Private Key de EmailJS (Dashboard > Account > API Keys)
EMAILJS_PRIVATE_KEY="tu_private_key"
# Service ID (Dashboard > Email Services > tu servicio)
EMAILJS_SERVICE_ID="tu_service_id"
# Template ID para email de bienvenida con credenciales
EMAILJS_TEMPLATE_WELCOME="template_welcome_id"
# Template ID para notificación de cambio de contraseña
EMAILJS_TEMPLATE_PASSWORD_CHANGED="template_password_changed_id"

# --------------------------------------------
# WHATSAPP (Evolution API)
# --------------------------------------------
# URL de la instancia de Evolution API (contenedor Docker local)
EVOLUTION_API_URL="http://localhost:8080"
# API Key configurada en Evolution API (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY="tu_evolution_api_key"
# Nombre de la instancia de WhatsApp (ej: "vymc")
EVOLUTION_INSTANCE_NAME="vymc"

# --------------------------------------------
# IA PARA MENSAJES DE WHATSAPP (Puter.js - sin API key)
# --------------------------------------------
# Prompts de sistema por tono. La IA (Grok vía Puter.js, en el navegador)
# redacta el mensaje; si falla o no están estas variables, se usa plantilla.
NEXT_PUBLIC_WHATSAPP_PROMPT_FRATERNAL="..."
NEXT_PUBLIC_WHATSAPP_PROMPT_FORMAL="..."
NEXT_PUBLIC_WHATSAPP_PROMPT_REMINDER="..."

# Prompt de sistema del Copiloto IA (chat flotante del módulo VYMC).
# Soporta el placeholder {{TODAY}} con la fecha actual.
NEXT_PUBLIC_COPILOT_SYSTEM_PROMPT="Eres un asistente experto en gestión de reuniones de Vida y Ministerio Cristiano (VYMC). Hoy es {{TODAY}}. Usa las herramientas disponibles para consultar información sobre publicadores, asignaciones, semanas del programa y estadísticas. Responde de forma concisa, profesional y útil en español."

# Prompt de sistema del Copiloto IA de Territorios (chat flotante del módulo de Territorios).
# Soporta el placeholder {{TODAY}} con la fecha actual.
NEXT_PUBLIC_COPILOT_TERRITORIOS_SYSTEM_PROMPT="Eres el 'Copiloto de Territorios', asistente virtual del sistema de gestión de territorios de predicación de una congregación de los Testigos de Jehová. Fecha de hoy: {{TODAY}}. Tu trabajo: - Responder consultas en lenguaje natural sobre territorios, asignaciones (regulares y personales), publicadores, grupos y estadísticas. - SIEMPRE que la pregunta requiera datos reales (historial, estado actual, disponibilidad, estadísticas), usa las herramientas disponibles para consultar la base de datos. No inventes datos. - Puedes encadenar varias herramientas si lo necesitas (ej: buscar el historial de varios territorios o publicadores). Estilo de respuesta: - Responde SIEMPRE en español, con tono fraternal, respetuoso, breve y claro. - Responde SOLO lo que se pregunta. No agregues información extra no solicitada. Si preguntan por territorios disponibles, NO menciones los asignados a menos que lo pidan explícitamente. - Usa listas cortas y ordenadas. Expresa los tiempos de forma humana: 'hace 3 semanas', 'hace 48 días', 'sin asignar desde hace 2 meses'. - No reveles detalles técnicos internos (SQL, Prisma, IDs internos, nombres de herramientas) nunca."

# --------------------------------------------
# PUERTO (Opcional)
# --------------------------------------------
# Puerto donde correrá la aplicación
PORT=3000
