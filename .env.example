# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================
# Copia este archivo como '.env' y configura tus valores

# --------------------------------------------
# BASE DE DATOS
# --------------------------------------------
# URL de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:admin@localhost:5432/territorios_db?schema=public"

# --------------------------------------------
# AUTENTICACIÓN
# --------------------------------------------
# URL pública de la aplicación (necesaria para JWT)
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key para JWT (genera uno seguro en producción)
# Puedes generar uno con: openssl rand -base64 32
JWT_SECRET="tu-secreto-super-seguro-cambialo-en-produccion"

# Email y contraseña del super admin
# En el primer login se crea el tenant admin con estos datos
ADMIN_EMAIL="admin@territorios.com"
ADMIN_PASSWORD="123456"

# --------------------------------------------
# API PARA IA
# --------------------------------------------
# Clave para que la IA se autentique en el endpoint /api/agent
# La IA debe enviarla en el header: Authorization: Bearer <API_KEY>
AI_API_KEY="cambia-esta-clave-por-una-segura"

# --------------------------------------------
# EMAILS (EmailJS)
# --------------------------------------------
# Configuración de EmailJS para enviar emails transaccionales
# Crear cuenta en: https://www.emailjs.com/
# Public Key de EmailJS (Dashboard > Account > API Keys)
EMAILJS_PUBLIC_KEY="tu_public_key"
# Private Key de EmailJS (Dashboard > Account > API Keys)
EMAILJS_PRIVATE_KEY="tu_private_key"
# Service ID (Dashboard > Email Services > tu servicio)
EMAILJS_SERVICE_ID="tu_service_id"
# Template ID para email de bienvenida con credenciales
EMAILJS_TEMPLATE_WELCOME="template_welcome_id"
# Template ID para notificación de cambio de contraseña
EMAILJS_TEMPLATE_PASSWORD_CHANGED="template_password_changed_id"

# --------------------------------------------
# WHATSAPP (Evolution API)
# --------------------------------------------
# URL de la instancia de Evolution API (contenedor Docker local)
EVOLUTION_API_URL="http://localhost:8080"
# API Key configurada en Evolution API (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY="tu_evolution_api_key"
# Nombre de la instancia de WhatsApp (ej: "vymc")
EVOLUTION_INSTANCE_NAME="vymc"

# --------------------------------------------
# IA — MULTI-PROVEEDOR (Gemini → Groq → OpenRouter)
# --------------------------------------------
# El cliente prueba los proveedores EN ORDEN (Gemini, Groq, OpenRouter).
# Basta con cargar la(s) key(s) que tengas; se omiten los proveedores sin key.
# Si un modelo falla, se lo saltea 15 minutos y pasa al siguiente.

# Proveedor 1 — Google Gemini (AI Studio): free sin tarjeta, cientos de req/día.
# Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODELS="gemini-flash-latest"

# Proveedor 2 — Groq: free sin tarjeta, hasta ~14.400 req/día (techo por tokens/minuto).
# Key en https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODELS="openai/gpt-oss-120b,qwen/qwen3.6-27b"

# Proveedor 3 — OpenRouter (última opción de la cadena).
# Key en https://openrouter.ai/settings/keys — modelos :free con límite 20 req/min, 50 req/día.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_FALLBACK_MODELS="z-ai/glm-5.2:free,google/gemma-4-31b-it:free,openrouter/free"

# Límites diarios del copiloto / IA de WhatsApp (por bucket)
AI_USER_DAILY_LIMIT=50
AI_GLOBAL_DAILY_LIMIT=500

# Prompts de sistema para los mensajes de WhatsApp por tono.
# Si fallan o no están estas variables, se usa plantilla determinista.
AI_WHATSAPP_PROMPT_FRATERNAL="..."
AI_WHATSAPP_PROMPT_FORMAL="..."
AI_WHATSAPP_PROMPT_REMINDER="..."

# Prompt de sistema del Copiloto IA (chat flotante del módulo VYMC).
# SOLO DEL SERVIDOR: ya no viaja al navegador. Soporta el placeholder {{TODAY}}.
AI_COPILOT_SYSTEM_PROMPT="Eres un asistente experto en gestión de reuniones de Vida y Ministerio Cristiano (VYMC). Hoy es {{TODAY}}. Usa las herramientas disponibles para consultar información sobre publicadores, asignaciones, semanas del programa y estadísticas. Responde de forma concisa, profesional y útil en español."

# Prompt de sistema del Copiloto IA de Territorios (chat flotante del módulo de Territorios).
# SOLO DEL SERVIDOR: ya no viaja al navegador. Soporta el placeholder {{TODAY}}.
AI_COPILOT_TERRITORIOS_SYSTEM_PROMPT="Eres el 'Copiloto de Territorios', asistente virtual del sistema de gestión de territorios de predicación de una congregación de los Testigos de Jehová. Fecha de hoy: {{TODAY}}. Tu trabajo: - Responder consultas en lenguaje natural sobre territorios, asignaciones (regulares y personales), publicadores, grupos y estadísticas. - SIEMPRE que la pregunta requiera datos reales (historial, estado actual, disponibilidad, estadísticas), usa las herramientas disponibles para consultar la base de datos. No inventes datos. - Puedes encadenar varias herramientas si lo necesitas (ej: buscar el historial de varios territorios o publicadores). Estilo de respuesta: - Responde SIEMPRE en español, con tono fraternal, respetuoso, breve y claro. - Responde SOLO lo que se pregunta. No agregues información extra no solicitada. Si preguntan por territorios disponibles, NO menciones los asignados a menos que lo pidan explícitamente. - Usa listas cortas y ordenadas. Expresa los tiempos de forma humana: 'hace 3 semanas', 'hace 48 días', 'sin asignar desde hace 2 meses'. - No reveles detalles técnicos internos (SQL, Prisma, IDs internos, nombres de herramientas) nunca."

# --------------------------------------------
# PUERTO (Opcional)
# --------------------------------------------
# Puerto donde correrá la aplicación
PORT=3000
