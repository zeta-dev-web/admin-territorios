generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════
//  TENANT / USER (multi-tenancy)
// ═══════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  groups              Group[]
  territories         Territory[]
  blocks              Block[]
  assignments         Assignment[]
  dailyRecords        DailyRecord[]
  personalAssignments PersonalAssignment[]
  maps                TerritoryMap[]
  apiKeys             ApiKey[]
  publishers          Publisher[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  role            String    @default("USER") // ADMIN | USER
  tenantId        String
  termsAcceptedAt DateTime? // Fecha en que aceptó los términos
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys ApiKey[]

  @@index([email])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  GRUPOS
// ═══════════════════════════════════════════

model Group {
  id             String   @id @default(cuid())
  name           String
  superintendent String?
  auxiliary      String?
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territories Territory[]
  publishers  Publisher[]

  @@index([name])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  INTEGRANTES

// ═══════════════════════════════════════════
//  CONDUCTORES

enum Gender {
  MALE
  FEMALE
}

// Fuente unica de personas para Territorios y VYMC. Los modelos legacy Member/Driver
// conservan temporalmente mientras la aplicacion cambia sus lecturas.
model Publisher {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  phone                String?
  gender               Gender?
  isBaptized           Boolean?
  isElder              Boolean   @default(false)
  isMinisterialServant Boolean   @default(false)
  isPioneer            Boolean   @default(false)
  isConductor          Boolean   @default(false)
  lastAssignedAt       DateTime?
  groupId              String
  tenantId             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignments         Assignment[]
  dailyRecords        DailyRecord[]
  personalAssignments PersonalAssignment[]

  @@index([tenantId])
  @@index([groupId])
  @@index([tenantId, groupId])
  @@index([tenantId, isConductor])
}

// ═══════════════════════════════════════════
//  TERRITORIOS
// ═══════════════════════════════════════════

model Territory {
  id          String   @id @default(cuid())
  number      Int
  description String?
  groupId     String
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group               Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignments         Assignment[]
  blocks              Block[]
  personalAssignments PersonalAssignment[]

  @@unique([tenantId, number]) // El numero es unico por tenant, no global
  @@index([number])
  @@index([groupId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  MANZANAS (BLOQUES)
// ═══════════════════════════════════════════

model Block {
  id           String   @id @default(cuid())
  letter       String
  territoryId  String
  assignmentId String?
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id])
  territory    Territory     @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  dailyRecords DailyRecord[]

  @@unique([territoryId, letter])
  @@index([territoryId])
  @@index([assignmentId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  ASIGNACIONES (Conductor)
// ═══════════════════════════════════════════

model Assignment {
  id          String    @id @default(cuid())
  territoryId String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isCompleted Boolean   @default(false)
  tenantId    String?
  publisherId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territory    Territory     @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  publisher    Publisher?    @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  blocks       Block[]
  dailyRecords DailyRecord[]

  @@index([territoryId])
  @@index([isCompleted])
  @@index([endDate])
  @@index([tenantId])
  @@index([publisherId])
}

// ═══════════════════════════════════════════
//  REGISTROS DIARIOS
// ═══════════════════════════════════════════

model DailyRecord {
  id           String   @id @default(cuid())
  assignmentId String
  blockId      String
  date         DateTime @default(now())
  notes        String?
  tenantId     String?
  publisherId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  block      Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  publisher  Publisher? @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, blockId, date])
  @@index([assignmentId])
  @@index([blockId])
  @@index([date])
  @@index([tenantId])
  @@index([publisherId])
}

// ═══════════════════════════════════════════
//  ASIGNACIONES PERSONALES
// ═══════════════════════════════════════════

model PersonalAssignment {
  id           String    @id @default(cuid())
  territoryId  String
  assignedDate DateTime  @default(now())
  returnedDate DateTime?
  isActive     Boolean   @default(true)
  notes        String?
  tenantId     String?
  publisherId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territory Territory  @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  publisher Publisher? @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  @@index([territoryId])
  @@index([isActive])
  @@index([assignedDate])
  @@index([returnedDate])
  @@index([tenantId])
  @@index([publisherId])
}

// ═══════════════════════════════════════════
//  MAPAS
// ═══════════════════════════════════════════

model TerritoryMap {
  id        String   @id @default(cuid())
  type      String // GENERAL | GROUP
  groupId   String?
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images MapImage[]

  @@index([type])
  @@index([groupId])
  @@index([tenantId])
}

model MapImage {
  id        String   @id @default(cuid())
  mapId     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  map TerritoryMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
}

// ═══════════════════════════════════════════
//  API KEYS (por usuario, para IA externa)
// ═══════════════════════════════════════════

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  userId     String
  tenantId   String
  name       String    @default("default")
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@index([tenantId])
}
