generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════
//  TENANT / USER (multi-tenancy)
// ═══════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  groups              Group[]
  territories         Territory[]
  blocks              Block[]
  assignments         Assignment[]
  dailyRecords        DailyRecord[]
  personalAssignments PersonalAssignment[]
  maps                TerritoryMap[]
  weeks               Week[]
  apiKeys             ApiKey[]
  publishers          Publisher[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  role            String    @default("USER") // ADMIN | USER
  tenantId        String
  termsAcceptedAt DateTime? // Fecha en que aceptó los términos
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  moduleAccess UserModuleAccess[]

  @@index([email])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  GRUPOS
// ═══════════════════════════════════════════

model Group {
  id             String   @id @default(cuid())
  name           String
  superintendent String?
  auxiliary      String?
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territories Territory[]
  publishers  Publisher[]

  @@index([name])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  INTEGRANTES

// ═══════════════════════════════════════════
//  CONDUCTORES

enum Gender {
  MALE
  FEMALE
}

// Fuente unica de personas para Territorios y VYMC. Los modelos legacy Member/Driver
// conservan temporalmente mientras la aplicacion cambia sus lecturas.
model Publisher {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  phone                String?
  gender               Gender?
  isBaptized           Boolean?
  isElder              Boolean   @default(false)
  isMinisterialServant Boolean   @default(false)
  isPioneer            Boolean   @default(false)
  isConductor          Boolean   @default(false)
  lastAssignedAt       DateTime?
  groupId              String
  tenantId             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant               Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group                Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assignments          Assignment[]
  dailyRecords         DailyRecord[]
  personalAssignments  PersonalAssignment[]
  meetingAssignments   MeetingAssignment[]
  weeksAsPresident     Week[]               @relation("WeekPresident")
  weeksAsOpeningPrayer Week[]               @relation("WeekOpeningPrayer")

  @@index([tenantId])
  @@index([groupId])
  @@index([tenantId, groupId])
  @@index([tenantId, isConductor])
}

// ═══════════════════════════════════════════
//  TERRITORIOS
// ═══════════════════════════════════════════

model Territory {
  id          String   @id @default(cuid())
  number      Int
  description String?
  groupId     String
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group               Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignments         Assignment[]
  blocks              Block[]
  personalAssignments PersonalAssignment[]

  @@unique([tenantId, number]) // El numero es unico por tenant, no global
  @@index([number])
  @@index([groupId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  MANZANAS (BLOQUES)
// ═══════════════════════════════════════════

model Block {
  id           String   @id @default(cuid())
  letter       String
  territoryId  String
  assignmentId String?
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment   Assignment?   @relation(fields: [assignmentId], references: [id])
  territory    Territory     @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  dailyRecords DailyRecord[]

  @@unique([territoryId, letter])
  @@index([territoryId])
  @@index([assignmentId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  ASIGNACIONES (Conductor)
// ═══════════════════════════════════════════

model Assignment {
  id          String    @id @default(cuid())
  territoryId String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  isCompleted Boolean   @default(false)
  tenantId    String?
  publisherId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territory    Territory     @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  publisher    Publisher?    @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  blocks       Block[]
  dailyRecords DailyRecord[]

  @@index([territoryId])
  @@index([isCompleted])
  @@index([endDate])
  @@index([tenantId])
  @@index([publisherId])
}

// ═══════════════════════════════════════════
//  REGISTROS DIARIOS
// ═══════════════════════════════════════════

model DailyRecord {
  id           String   @id @default(cuid())
  assignmentId String
  blockId      String
  date         DateTime @default(now())
  notes        String?
  tenantId     String?
  publisherId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  block      Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  publisher  Publisher? @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, blockId, date])
  @@index([assignmentId])
  @@index([blockId])
  @@index([date])
  @@index([tenantId])
  @@index([publisherId])
}

// ═══════════════════════════════════════════
//  ASIGNACIONES PERSONALES
// ═══════════════════════════════════════════

model PersonalAssignment {
  id           String    @id @default(cuid())
  territoryId  String
  assignedDate DateTime  @default(now())
  returnedDate DateTime?
  isActive     Boolean   @default(true)
  notes        String?
  tenantId     String?
  publisherId  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  territory Territory  @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  publisher Publisher? @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  @@index([territoryId])
  @@index([isActive])
  @@index([assignedDate])
  @@index([returnedDate])
  @@index([tenantId])
  @@index([publisherId])
}

// ═══════════════════════════════════════════
//  MAPAS
// ═══════════════════════════════════════════

model TerritoryMap {
  id        String   @id @default(cuid())
  type      String // GENERAL | GROUP
  groupId   String?
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  images MapImage[]

  @@index([type])
  @@index([groupId])
  @@index([tenantId])
}

model MapImage {
  id        String   @id @default(cuid())
  mapId     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  map TerritoryMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
}

// ═══════════════════════════════════════════
//  API KEYS (por usuario, para IA externa)
// ═══════════════════════════════════════════

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  userId     String
  tenantId   String
  name       String    @default("default")
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@index([tenantId])
}

// ═══════════════════════════════════════════
//  MÓDULO VYMC (Reunión Vida y Ministerio)
//  Tablas portadas del sistema VYMC con nombres
//  unificados. Fuente: PLAN_UNIFICACION §6.
// ═══════════════════════════════════════════

enum ModuleCode {
  TERRITORIES
  VYMC
}

model UserModuleAccess {
  userId String
  module ModuleCode

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@index([module])
}

enum SectionType {
  PRESIDENT
  OPENING_PRAYER
  TREASURES
  BE_BETTER_TEACHERS
  CHRISTIAN_LIFE
  CLOSING_PRAYER
}

enum ItemType {
  SPEECH
  READING
  DISCUSSION
  CONDUCTOR_READER
  PRAYER
}

enum AssignmentRole {
  ASSIGNEE
  STUDENT
  HELPER
  CONDUCTOR
  READER
}

model Week {
  id              String    @id @default(cuid())
  weekNumber      Int
  year            Int
  startDate       DateTime
  endDate         DateTime
  tenantId        String
  presidentId     String?
  openingPrayerId String?
  biblicalReading String?
  scrapedAt       DateTime?
  isConfirmed     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  president     Publisher?    @relation("WeekPresident", fields: [presidentId], references: [id], onDelete: SetNull)
  openingPrayer Publisher?    @relation("WeekOpeningPrayer", fields: [openingPrayerId], references: [id], onDelete: SetNull)
  sections      WeekSection[]

  @@unique([tenantId, weekNumber, year])
  @@index([tenantId])
  @@index([presidentId])
  @@index([openingPrayerId])
}

model WeekSection {
  id          String      @id @default(cuid())
  weekId      String
  sectionType SectionType
  order       Int
  createdAt   DateTime    @default(now())

  week  Week       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  items WeekItem[]

  @@index([weekId])
}

model WeekItem {
  id                    String   @id @default(cuid())
  weekSectionId         String
  title                 String
  itemType              ItemType
  order                 Int
  requiresStudentHelper Boolean  @default(false)
  timeMinutes           Int?
  songNumber            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  weekSection WeekSection         @relation(fields: [weekSectionId], references: [id], onDelete: Cascade)
  assignments MeetingAssignment[]

  @@index([weekSectionId])
}

/// Ex "Assignment" de VYMC: asignación de una parte de la reunión.
model MeetingAssignment {
  id          String         @id @default(cuid())
  weekItemId  String
  publisherId String
  role        AssignmentRole
  createdAt   DateTime       @default(now())

  weekItem  WeekItem  @relation(fields: [weekItemId], references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([weekItemId, role])
  @@index([weekItemId])
  @@index([publisherId])
}
